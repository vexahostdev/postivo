# =============================================================================
# Postivo — lingkungan: staging
# Salin ke .env lalu isi nilai kosong. File .env* (tanpa .example) tidak boleh di-commit.
# =============================================================================
APP_NAME=Postivo
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.postivo.my.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# --- Database -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=postivo_staging
DB_USERNAME=postivo_staging
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Session / cache / queue ---------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email sistem (verifikasi, reset password, invoice, peringatan) ---------------
# Dev: "log" (isi email ditulis ke storage/logs). Staging/production: "brevo".
MAIL_MAILER=brevo
MAIL_FROM_ADDRESS=noreply@postivo.my.id
MAIL_FROM_NAME=Postivo
POSTIVO_SUPPORT_EMAIL=support@postivo.my.id
# Kredensial Brevo SMTP — KOSONGKAN sampai akun Brevo dibuat (Brevo > SMTP & API > SMTP).
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# --- Host & DNS pelanggan --------------------------------------------------------
POSTIVO_APP_HOST=staging.postivo.my.id
POSTIVO_API_URL=https://api-staging.postivo.my.id
POSTIVO_SMTP_HOST=smtp-staging.postivo.my.id
POSTIVO_SPF_INCLUDE=spf-staging.postivo.my.id
POSTIVO_BOUNCE_TARGET=bounce-staging.postivo.my.id
POSTIVO_TRACKING_TARGET=trk-staging.postivo.my.id
POSTIVO_TRACKING_URL=https://trk-staging.postivo.my.id
POSTIVO_DMARC_RUA=dmarc@postivo.my.id
POSTIVO_DNS_ASSUME_OK=false

# --- Relay pengiriman email pelanggan --------------------------------------------
# log = simulasi (tulis .eml), smtp = Stalwart utama + Brevo fallback.
POSTIVO_RELAY=smtp
POSTIVO_STALWART_DSN=
POSTIVO_BREVO_DSN=
POSTIVO_INTERNAL_SECRET=
POSTIVO_WEBHOOK_ALLOW_LOCAL=false
# POSTIVO_SPOOL_DIR=

# --- Pembayaran (Xendit via webhook sentral VexaHost) -----------------------------
# Callback Xendit masuk ke VexaHost, lalu diteruskan ke https://staging.postivo.my.id/api/payment/xendit/callback
# VexaHost meneruskan invoice ber-prefix external_id "PSV-" dengan header X-Internal-Token.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
INTERNAL_WEBHOOK_SECRET=
POSTIVO_BILLING_SIMULATOR=false

# --- Admin panel platform (/admin) -------------------------------------------------
# 2FA TOTP wajib untuk staf. Default: true di production, false selain itu.
ADMIN_REQUIRE_2FA=true
# IP yang boleh membuka /admin (CSV). Kosong = semua IP (tetap butuh login staf + 2FA).
ADMIN_IP_ALLOWLIST=
ADMIN_SESSION_MINUTES=120
# Superadmin awal: php artisan postivo:admin:create (isi di file .env asli, bukan di sini)
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Keamanan web -----------------------------------------------------------------
# Content-Security-Policy: off | report | enforce (mulai "report", naikkan ke enforce setelah dicek).
POSTIVO_CSP=report
